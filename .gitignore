# =============================================================================
data/raw/
data/processed/

# =============================================================================
# Model checkpoints, FAISS indices, embeddings
# (all under outputs/ — regenerated by train_classifier.py / index.py)
# =============================================================================
outputs/

# Explicit weight/index extensions in case they end up elsewhere
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.faiss
*.npy

# =============================================================================
# Results — keep small JSON metric files, ignore large JSONL prediction dumps
# =============================================================================
# Ignored:  results/predictions/  (legacy path)
#           results/pipelines/    (per-example LLM outputs, can be 10s of MB)
results/predictions/
results/pipelines/

# Keep committed:
#   results/baselines/*.json        (classification metrics)
#   results/augmentation/*.json     (synthetic data log)
#   results/evaluation/*.json       (diversity + ablation results)

